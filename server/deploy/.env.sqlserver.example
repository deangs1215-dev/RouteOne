# Server-side .env for running RouteOne on SQL Server. Copy to server\.env on the
# server (deploy.bat never overwrites it). Values in <angle brackets> are yours.

# Database backend. Remove this line (or set sqlite) to roll back to fieldsales.db.
DB_BACKEND=mssql
DB_HOST=<sql server host>
DB_PORT=1433
DB_NAME=RouteOne
DB_USER=RouteOneApp
# Quote the password if it contains '#' - unquoted, everything after it is dropped.
DB_PASSWORD="<password>"
# 1 to require an encrypted connection (needs a trusted certificate on the server).
DB_ENCRYPT=0
# Connections held open by the API (default 10).
DB_POOL_MAX=10

# MUST stay exactly as it is today. SMTP and SYSPRO passwords stored in the
# settings table are encrypted with this key; a different one makes them
# undecryptable ("Failed to decrypt secret").
SECRET_KEY=<unchanged>
